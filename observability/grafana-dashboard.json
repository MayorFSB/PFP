{
  "title": "PFP business",
  "uid": "fg04mtu39s8owb",
  "tags": ["pfp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "filial",
        "label": "Филиал",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(bookings_total, filial)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Броней за 1ч",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bookings_total{filial=~\"$filial\"}[1h]))",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP p95 (5м)",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_latency_seconds_bucket[5m])))",
          "instant": true,
          "format": "s"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Cache hit ratio",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_miss_total[5m])))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx за 15м",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_requests_total{status=~\"5..\"}[15m]))",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Брони по филиалам (1ч окна)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (filial) (increase(bookings_total{filial=~\"$filial\"}[1h]))"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP p95 по эндпоинтам (5м)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_latency_seconds_bucket[5m])))",
          "format": "s"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Кэш: hits/misses (5м rate)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(cache_hits_total[5m]))", "legendFormat": "hits" },
        { "refId": "B", "expr": "sum(rate(cache_miss_total[5m]))", "legendFormat": "misses" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP-ответы по статусам (5м rate)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[5m]))"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Логи приложения (structlog JSON → Loki)",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 20 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"pfp\"} | json | level != `debug`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
