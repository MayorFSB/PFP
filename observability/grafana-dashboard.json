{
  "title": "PFP business",
  "panels": [
    {
      "title": "Bookings by filial",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (filial) (increase(bookings_total[1h]))" }]
    },
    {
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_latency_seconds_bucket[5m])))" }]
    },
    {
      "title": "Cache hit ratio",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_miss_total[5m])))" }]
    }
  ]
}
